<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Messaging and event-driven architecture for MinimalCleanArch using Wolverine. Includes domain events, transactional outbox, and background job processing.</Description>
    <PackageTags>clean-architecture;wolverine;messaging;domain-events;outbox;cqrs</PackageTags>
    <!-- NU1608: residual graph noise around Roslyn; packages are pinned centrally in Directory.Packages.props -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="WolverineFx" />
    <PackageReference Include="WolverineFx.EntityFrameworkCore" />
    <PackageReference Include="WolverineFx.Http" />
    <PackageReference Include="WolverineFx.SqlServer" />
    <PackageReference Include="WolverineFx.Postgresql" />
    <!-- Pin Roslyn with Wolverine to keep the dependency graph aligned -->
    <PackageReference Include="Microsoft.CodeAnalysis.Common" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MinimalCleanArch\MinimalCleanArch.csproj" />
  </ItemGroup>

</Project>
