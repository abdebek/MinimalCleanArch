<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Realtime publish port (channel, payload, tenant/user audience). No SignalR types on the port.</Description>
    <PackageTags>clean-architecture;realtime;signalr</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" VersionOverride="9.0.18" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
