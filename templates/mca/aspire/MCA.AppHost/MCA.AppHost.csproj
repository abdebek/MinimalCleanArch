<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>__MCA_TFM__</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <IsPackable>false</IsPackable>
    <UserSecretsId>mca-aspire-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <!--#if (UsePostgres)-->
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="17.0.0" />
    <!--#endif-->
    <!--#if (UseSqlServer)-->
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="17.0.0" />
    <!--#endif-->
    <!--#if (UseCaching)-->
    <PackageReference Include="Aspire.Hosting.Redis" Version="17.0.0" />
    <!--#endif-->
  </ItemGroup>

</Project>
