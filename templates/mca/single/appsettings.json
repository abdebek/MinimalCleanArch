{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
#if (UsePostgres)
    "DefaultConnection": "Host=localhost;Database=__DB_NAME__;Username=postgres;Password=postgres"
#endif
#if (UseSqlServer)
    "DefaultConnection": "Server=localhost,1433;Database=__DB_NAME__;User Id=sa;Password=StrongP!12asd;TrustServerCertificate=True;MultipleActiveResultSets=true"
#endif
#if (UseSqlite)
    "DefaultConnection": "Data Source=__DB_NAME__.db"
#endif
  },
  "Database": {
    "EnsureCreated": false,
    "ApplyMigrations": false
  }
#if (UseSecurity)
  ,"Cors": {
    "AllowedOrigins": [
#if (UseFrontend)
      "http://localhost:4321",
      "http://localhost:3000",
      "http://127.0.0.1:4321",
      "http://127.0.0.1:3000"
#endif
    ]
  }
  ,"Encryption": {
    "Key": ""
  }
#elif (UseFrontend)
  ,"Cors": {
    "AllowedOrigins": [
      "http://localhost:4321",
      "http://localhost:3000",
      "http://127.0.0.1:4321",
      "http://127.0.0.1:3000"
    ]
  }
#endif
#if (UseStorage)
  ,"BlobStorage": {
    "Provider": "Azure",
    "ConnectionString": "UseDevelopmentStorage=true",
    "ContainerName": "app-data",
    "UploadUrlTtlMinutes": 15,
    "DownloadUrlTtlMinutes": 15,
    "R2ServiceUrl": "",
    "R2AccessKeyId": "",
    "R2SecretAccessKey": "",
    "R2BucketName": "",
    "R2PublicBaseUrl": "",
    "KeyPrefix": ""
  }
#endif
#if (UseCaching)
  ,"Caching": {
    "Redis": {
      "ConnectionString": ""
    }
  }
#endif
#if (UseFeatures)
  ,"Features": {
    "Flags": {
      "todo-export": false
    }
  }
#endif
#if (UseRateLimiting)
  ,"RateLimiting": {
    "EnableGlobalLimiter": true,
    "UseForwardedHeaders": true,
    "GlobalPermitLimit": 240,
    "GlobalWindow": "00:01:00",
    "GlobalQueueLimit": 0,
    "FixedPermitLimit": 60,
    "FixedWindow": "00:01:00",
    "FixedQueueLimit": 0,
    "SlidingPermitLimit": 120,
    "SlidingWindow": "00:01:00",
    "SlidingSegmentsPerWindow": 4,
    "SlidingQueueLimit": 0,
    "TokenBucketLimit": 10,
    "TokenReplenishmentPeriod": "00:01:00",
    "TokensPerPeriod": 10,
    "TokenQueueLimit": 0,
    "ConcurrencyPermitLimit": 20,
    "ConcurrencyQueueLimit": 5
  }
#endif
#if (UseAuth)
  ,"App": {
    "BaseUrl": "https://localhost:__HTTPS_PORT__"
  }
  ,"Seed": {
    "EnableBootstrapAdmin": false,
    "AdminEmail": "admin@example.com",
    "AdminPassword": "",
    "AdminFirstName": "System",
    "AdminLastName": "Administrator",
    "AdminRole": "Admin"
  }
  ,"OpenIddict": {
    "SigningCertificate": { "Source": "None" },
    "EncryptionCertificate": { "Source": "None" },
    "TokenLifetimes": {
      "AccessToken": "01:00:00",
      "RefreshToken": "14.00:00:00",
      "AuthorizationCode": "00:05:00",
      "IdentityToken": "01:00:00"
    },
    "Clients": {
      "Web": {
        "ClientId": "mca-web-client",
        "Secret": "mca-default-secret-change-me"
      }
#if (UseFrontend)
      ,"Spa": {
        "ClientId": "mca-spa-client",
        "RedirectUris": [
          "http://localhost:4321/callback",
          "http://localhost:3000/callback",
          "http://127.0.0.1:4321/callback",
          "http://127.0.0.1:3000/callback"
        ],
        "PostLogoutRedirectUris": [
          "http://localhost:4321/",
          "http://localhost:3000/",
          "http://127.0.0.1:4321/",
          "http://127.0.0.1:3000/"
        ]
      }
#endif
    },
    "AllowedOrigins": []
  }
  ,"Authentication": {
    "Google": { "ClientId": "", "ClientSecret": "" },
    "Microsoft": { "ClientId": "", "ClientSecret": "" },
    "GitHub": { "ClientId": "", "ClientSecret": "" }
  }
  ,"EmailSettings": {
    "Provider": "Smtp",
    "SmtpServer": "localhost",
    "Port": 25,
    "SenderEmail": "no-reply@example.com",
    "SenderName": "MCA",
    "Username": "",
    "Password": "",
    "EnableSsl": false,
    "UseDefaultCredentials": false,
    "TimeoutSeconds": 30,
    "AppBaseUrl": "https://localhost:__HTTPS_PORT__",
    "AppName": "MCA",
    "Api": {
      "Endpoint": "",
      "ApiKey": "",
      "ApiKeyHeaderName": "Authorization",
      "ApiKeyPrefix": "Bearer",
      "Headers": {}
    }
  }
#endif
}
