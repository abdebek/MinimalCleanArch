<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>__MCA_TFM__</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);NU1608;NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinimalCleanArch" Version="__MCA_VERSION__" />
    <PackageReference Include="MinimalCleanArch.DataAccess" Version="__MCA_VERSION__" />
    <!--#if (UseSecurity)-->
    <PackageReference Include="MinimalCleanArch.Security" Version="__MCA_VERSION__" />
    <!--#endif-->
    <!--#if (UseAudit)-->
    <PackageReference Include="MinimalCleanArch.Audit" Version="__MCA_VERSION__" />
    <!--#endif-->
    <!--#if (UseAuth)-->
    <PackageReference Include="MinimalCleanArch.Email" Version="__MCA_VERSION__" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.6.0" />
    <!--#endif-->
  </ItemGroup>

  <ItemGroup>
    <!--#if (UseSqlite)-->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
    <!--#endif-->
    <!--#if (UseSqlServer)-->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0" />
    <!--#endif-->
    <!--#if (UsePostgres)-->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-rc.3" />
    <!--#endif-->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="11.0.0" />
    <!--#if (UseCaching)-->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0" />
    <!--#endif-->
    <!--#if (UseAuth)-->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="11.0.0" />
    <!--#endif-->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MCA.Domain\MCA.Domain.csproj" />
    <ProjectReference Include="..\MCA.Application\MCA.Application.csproj" />
  </ItemGroup>

</Project>
