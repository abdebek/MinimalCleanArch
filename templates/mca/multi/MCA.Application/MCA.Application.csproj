<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>__MCA_TFM__</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);NU1608;NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinimalCleanArch" Version="__MCA_VERSION__" />
    <!--#if (UseCaching)-->
    <PackageReference Include="MinimalCleanArch.Extensions" Version="__MCA_VERSION__" />
    <!--#endif-->
    <!--#if (UseJobs)-->
    <PackageReference Include="MinimalCleanArch.Jobs" Version="__MCA_VERSION__" />
    <!--#endif-->
    <!--#if (UseRealtime)-->
    <PackageReference Include="MinimalCleanArch.Realtime" Version="__MCA_VERSION__" />
    <!--#endif-->
    <!--#if (UseValidation)-->
    <PackageReference Include="MinimalCleanArch.Validation" Version="__MCA_VERSION__" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <!--#endif-->
  </ItemGroup>

  <!--#if (UseNet9)-->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.18" />
    <!--#if (UseAuth)-->
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" Version="9.0.18" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="9.0.18" />
    <!--#endif-->
  </ItemGroup>
  <!--#endif-->

  <!--#if (UseNet10)-->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <!--#if (UseAuth)-->
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.10" />
    <!--#endif-->
  </ItemGroup>
  <!--#endif-->

  <ItemGroup>
    <ProjectReference Include="..\MCA.Domain\MCA.Domain.csproj" />
  </ItemGroup>

</Project>
