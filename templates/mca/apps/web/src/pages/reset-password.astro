---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Reset password">
  <div class="card stack">
    <h1 data-i18n="reset">Reset password</h1>
    <form id="form" class="stack">
      <label>User id <input name="userId" required /></label>
      <label>Token <input name="token" required /></label>
      <label>New password <input name="newPassword" type="password" required minlength="8" /></label>
      <button type="submit">Reset</button>
    </form>
    <p id="msg" class="muted"></p>
  </div>
  <script>
    import { apiUrl } from "../lib/config";
    const params = new URLSearchParams(window.location.search);
    const form = document.getElementById("form") as HTMLFormElement;
    (form.elements.namedItem("userId") as HTMLInputElement).value = params.get("userId") ?? "";
    (form.elements.namedItem("token") as HTMLInputElement).value = params.get("token") ?? "";
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const body = Object.fromEntries(new FormData(form).entries());
      const res = await fetch(`${apiUrl}/api/auth/reset-password`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      document.getElementById("msg")!.textContent = res.ok ? "Password reset. Sign in." : await res.text();
    });
  </script>
</Layout>
